{
  "schema_version": "1.0",
  "company": "金华得创",
  "process": {
    "number": "03",
    "name": "销售订单",
    "status": "draft",
    "summary": "从客户提出采购需求，到审核、出库和 ERP 闭环。"
  },
  "nodes": [
    {
      "id": "S01",
      "type": "start",
      "label": "客户向业务员提出采购需求",
      "next": "A01"
    },
    {
      "id": "A01",
      "type": "action",
      "owner": "业务员",
      "label": "填写销售订单并关联客户档案",
      "next": "A02"
    },
    {
      "id": "A02",
      "type": "action",
      "owner": "业务员",
      "label": "将销售订单提交商务主管审核",
      "next": "D01"
    },
    {
      "id": "D01",
      "type": "decision",
      "owner": "商务主管",
      "title": "账期审核",
      "question": "客户账期是否符合公司规则？",
      "inputs": ["客户类型", "客户申请账期", "公司账期规则"],
      "criteria": [
        {
          "text": "现有材料同时出现“新客户现款现货”和“默认 21 天”，适用关系待确认",
          "status": "unresolved",
          "evidence": "自然语言资料中的两条规则存在适用范围歧义"
        }
      ],
      "branches": [
        {
          "label": "符合账期规则",
          "condition": "客户类型和申请账期符合公司现行规则",
          "target": "D02",
          "status": "confirmed",
          "primary": true
        },
        {
          "label": "不符合账期规则",
          "condition": "账期适用规则待确认",
          "target": "U01",
          "status": "unresolved",
          "primary": false
        }
      ]
    },
    {
      "id": "U01",
      "type": "unresolved",
      "owner": "待确认",
      "label": "调整账期、退回或终止方式待确认"
    },
    {
      "id": "D02",
      "type": "decision",
      "owner": "商务主管",
      "title": "价格审核",
      "question": "销售价格是否正确？",
      "inputs": ["商品", "数量", "销售价格", "公司价格基准"],
      "criteria": [
        {
          "text": "标准价格来源、最低价格和允许偏差待确认",
          "status": "unresolved",
          "evidence": "现有资料只说明需要审核价格"
        }
      ],
      "branches": [
        {
          "label": "价格正确",
          "condition": "销售价格符合公司价格基准和允许偏差",
          "target": "D03",
          "status": "confirmed",
          "primary": true
        },
        {
          "label": "价格不正确",
          "condition": "价格基准和允许偏差待确认",
          "target": "U02",
          "status": "unresolved",
          "primary": false
        }
      ]
    },
    {
      "id": "U02",
      "type": "unresolved",
      "owner": "待确认",
      "label": "退回对象及重新提交方式待确认"
    },
    {
      "id": "D03",
      "type": "decision",
      "owner": "商务主管",
      "title": "风险审核",
      "question": "订单风险是否可以接受？",
      "inputs": ["客户历史", "订单金额", "订单变化", "付款条件"],
      "criteria": [
        {
          "text": "突然出现的大额订单可能属于高风险，其余判断项目和标准待确认",
          "status": "unresolved",
          "evidence": "现有资料明确提到突然大额订单"
        }
      ],
      "branches": [
        {
          "label": "风险可以接受",
          "condition": "未触发公司定义的高风险情形",
          "target": "D04",
          "status": "confirmed",
          "primary": true
        },
        {
          "label": "风险不可接受",
          "condition": "风险判断标准待确认",
          "target": "U03",
          "status": "unresolved",
          "primary": false
        }
      ]
    },
    {
      "id": "U03",
      "type": "unresolved",
      "owner": "待确认",
      "label": "退回、暂停或终止方式待确认"
    },
    {
      "id": "D04",
      "type": "decision",
      "owner": "商务主管",
      "title": "审批路由",
      "question": "是否触发老板审批？",
      "inputs": ["订单金额", "客户是否为新客户", "是否为首单"],
      "criteria": [
        {
          "text": "订单金额大于 X 万",
          "status": "unresolved",
          "evidence": "金额阈值 X 尚未提供"
        },
        {
          "text": "新客户首单",
          "status": "confirmed",
          "evidence": "现有资料明确列为触发因素"
        },
        {
          "text": "两个条件是任一满足还是同时满足，待确认",
          "status": "unresolved",
          "evidence": "现有资料未说明条件组合关系"
        }
      ],
      "branches": [
        {
          "label": "触发老板审批",
          "condition": "满足老板审批触发规则",
          "target": "D05",
          "status": "unresolved",
          "primary": true
        },
        {
          "label": "不触发老板审批",
          "condition": "不满足老板审批触发规则",
          "target": "A03",
          "status": "unresolved",
          "primary": false
        }
      ]
    },
    {
      "id": "D05",
      "type": "decision",
      "owner": "老板",
      "title": "最终审批",
      "question": "老板是否批准订单？",
      "inputs": ["待确认"],
      "criteria": [
        {
          "text": "审批查看信息和批准标准待确认",
          "status": "unresolved",
          "evidence": "现有资料未提供老板的审批标准"
        }
      ],
      "branches": [
        {
          "label": "批准",
          "condition": "符合老板审批标准，具体标准待确认",
          "target": "A03",
          "status": "unresolved",
          "primary": true
        },
        {
          "label": "拒绝",
          "condition": "不符合老板审批标准，具体标准待确认",
          "target": "U04",
          "status": "unresolved",
          "primary": false
        }
      ]
    },
    {
      "id": "U04",
      "type": "unresolved",
      "owner": "待确认",
      "label": "退回、修改或终止方式待确认"
    },
    {
      "id": "A03",
      "type": "action",
      "owner": "仓管",
      "label": "根据已审核销售订单扫码出库",
      "next": "A04"
    },
    {
      "id": "A04",
      "type": "action",
      "owner": "仓管",
      "label": "在 ERP 中完成订单闭环",
      "next": "T01"
    },
    {
      "id": "T01",
      "type": "terminal",
      "label": "销售订单完成"
    }
  ],
  "pending_questions": [
    "“新客户现款现货”和“默认 21 天”分别适用于哪些客户和订单？",
    "销售价格以什么为基准？允许多大偏差？",
    "除突然大额订单外，还有哪些风险判断项目？",
    "每项风险满足什么条件时算“不可接受”？",
    "大额订单的金额阈值 X 是多少？",
    "“大额订单”和“新客户首单”是任一满足就提交老板，还是必须同时满足？",
    "老板审批订单时具体查看哪些信息、采用什么标准？",
    "主管或老板拒绝后，订单退给谁，能否修改并重新提交？"
  ],
  "sources": [
    "用户提供的纯文字对话与资料"
  ]
}
