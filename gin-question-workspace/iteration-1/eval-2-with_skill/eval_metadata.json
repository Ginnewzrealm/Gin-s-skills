{
  "eval_id": 2,
  "eval_name": "一棵树真问题检索",
  "prompt": "帮我全量找一棵树的真问题，输出 JSON 和 Markdown 两份文件",
  "assertions": [
    {
      "name": "输出文件齐全",
      "description": "problem_list.json, problem_list.md, audit_report.json 三个文件都存在",
      "check": "file_exists",
      "files": ["problem_list.json", "problem_list.md", "audit_report.json"]
    },
    {
      "name": "JSON 格式有效",
      "description": "problem_list.json 符合 output-schema.json",
      "check": "json_schema",
      "file": "problem_list.json"
    },
    {
      "name": "主清单非空",
      "description": "problems 数组至少包含 3 条问题",
      "check": "min_array_length",
      "file": "problem_list.json",
      "path": "problems",
      "min": 3
    },
    {
      "name": "问题有来源",
      "description": "每条问题至少有一个 source_url",
      "check": "all_have_field",
      "file": "problem_list.json",
      "path": "problems",
      "field": "sources"
    },
    {
      "name": "审计报告完整",
      "description": "audit_report.json 包含 perspective_coverage",
      "check": "has_fields",
      "file": "audit_report.json",
      "fields": ["perspective_coverage"]
    }
  ]
}
